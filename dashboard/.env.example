# AGY Dashboard - plug-in endpoint configuration
# Every external system plugs in here. Leave unset until its pod exists;
# panels will honestly show "UNREGISTERED" instead of faking data.

# Port for the dashboard server (default 3000)
PORT=3000

# ── Your external vLLM project (OpenAI-compatible API) ─────────────
# Feeds: Arsenal "Inference" card (/api/vllm/status) AND the generative
# engine (GenUI + chat brain) when INFERENCE_API_URL is not set.
VLLM_API_URL=
# Model name served by vLLM (used for chat + GenUI generation)
VLLM_MODEL=local-model

# ── LLM router (LiteLLM inference pod, OpenAI-compatible) ─────────
# Takes precedence over VLLM_API_URL for generative features.
INFERENCE_API_URL=
INFERENCE_MODEL=

# ── Dedicated chat/orchestrator pod ────────────────────────────────
# When set, POST /api/chat/execute proxies SSE to this base URL.
CHAT_API_URL=

# ── Arsenal panel adapters ─────────────────────────────────────────
MCP_API_URL=
PROMPTS_API_URL=
RAG_API_URL=

# ── Telemetry agent (real podman/container stats) ──────────────────
# When unset, the dashboard streams REAL stats of its own container
# (os.cpus / memory / proc network counters).
TELEMETRY_SOURCE_URL=

# ── Podman agent (security panel: real container/port isolation) ───
PODMAN_API_URL=

# ── Self-declared network posture of the dashboard container ──────
# internal = no outbound route, bridged = outbound access allowed
POD_NETWORK_ISOLATION=internal

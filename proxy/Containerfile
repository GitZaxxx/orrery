# Dockerfile for AGY Command Center Proxy Pod
# Based on NGINX for reverse proxy, load balancing, and SSL termination

FROM nginx:alpine

# Remove default configuration
RUN rm /etc/nginx/conf.d/default.conf

# Create non-root user for security (nginx already runs as non-root in alpine)
# But let's ensure we have proper permissions

# Copy custom configuration
COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/ /etc/nginx/conf.d/
COPY ssl/ /etc/nginx/ssl/ 2>/dev/null || true
COPY lua/ /etc/nginx/lua/ 2>/dev/null || true

# Create cache and runtime directories with proper permissions
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /etc/nginx/conf.d /etc/nginx/ssl /etc/nginx/lua

# Expose ports
EXPOSE 80  # HTTP
EXPOSE 443 # HTTPS

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-check-certificate --quiet --tries=1 --spider http://localhost:80/health || exit 1

# Use nginx's official image user (nginx)
USER nginx

# Labels for metadata
LABEL org.opencontainers.image.title="AGY Command Center Proxy"
LABEL org.opencontainers.image.description="Reverse proxy, load balancer, and security gateway for AGY Command Center"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/your-org/agy-command-center"

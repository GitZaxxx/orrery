# Dockerfile for AGY Command Center Inference Pod
# Supports multiple LLM backends: Ollama, vLLM, TGI, HuggingFace

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

# Install Python dependencies
COPY --chown=appuser:appuser requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY --chown=appuser:appuser . .

# Expose ports for different services
EXPOSE 8000  # LiteLLM proxy
EXPOSE 11434 # Ollama
EXPOSE 8080  # vLLM
EXPOSE 6006  # TGI (Text Generation Infrastructure)

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Default model settings
    DEFAULT_MODEL="llama3" \
    EMBEDDING_MODEL="all-MiniLM-L6-v2" \
    # Service ports
    LITELLM_PORT=8000 \
    OLLAMA_PORT=11434 \
    VLLM_PORT=8080 \
    TGI_PORT=6006

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${LITELLM_PORT}/health || exit 1

# Default command
CMD ["python", "-m", "litellm", "--host", "0.0.0.0", "--port", "8000"]

# Labels for metadata
LABEL org.opencontainers.image.title="AGY Command Center Inference"
LABEL org.opencontainers.image.description="AI inference services for AGY Command Center"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/your-org/agy-command-center"
